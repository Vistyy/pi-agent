{
    "providers": {
        "openai-codex": {
            "modelOverrides": {
                "gpt-5.6-sol": {
                    "contextWindow": 200000
                },
                "gpt-5.6-terra": {
                    "contextWindow": 200000
                },
                "gpt-5.6-luna": {
                    "contextWindow": 200000
                }
            }
        },
        "deepseek": {
            "baseUrl": "https://api.deepseek.com",
            "api": "openai-completions",
            "apiKey": "$DEEPSEEK_API_KEY",
            "authHeader": true,
            "compat": {
                "supportsStore": false,
                "supportsDeveloperRole": false,
                "supportsReasoningEffort": true,
                "maxTokensField": "max_tokens",
                "requiresReasoningContentOnAssistantMessages": true,
                "thinkingFormat": "deepseek"
            },
            "models": [
                {
                    "id": "deepseek-v4-flash",
                    "name": "DeepSeek V4 Flash",
                    "reasoning": true,
                    "thinkingLevelMap": {
                        "off": "disabled",
                        "minimal": null,
                        "low": "low",
                        "medium": null,
                        "high": "high",
                        "xhigh": null,
                        "max": "max"
                    },
                    "input": [
                        "text"
                    ],
                    "contextWindow": 300000,
                    "cost": {
                        "input": 0.14,
                        "output": 0.28,
                        "cacheRead": 0.0028,
                        "cacheWrite": 0.14
                    }
                }
            ]
        },
        "openrouter": {
            "modelOverrides": {
                "moonshotai/kimi-k2.7-code": {
                    "compat": {
                        "openRouterRouting": {
                            "only": [
                                "moonshotai"
                            ]
                        }
                    }
                }
            }
        }
    }
}