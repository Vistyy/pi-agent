{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed behavioral evaluation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recorded_at",
    "record_reason",
    "behavior_id",
    "suite_role",
    "system",
    "grader",
    "repository",
    "case_results",
    "decision",
    "source_runs"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "recorded_at": { "type": "string", "format": "date-time" },
    "record_reason": {
      "enum": [
        "first_qualification",
        "status_change",
        "reliability_change",
        "suite_or_grader_change",
        "product_decision"
      ]
    },
    "behavior_id": { "type": "string", "minLength": 1 },
    "suite_role": { "enum": ["capability", "regression", "challenge"] },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "model", "thinking_level"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "thinking_level": { "type": "string", "minLength": 1 }
      }
    },
    "grader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "judge_model": { "type": "string", "minLength": 1 }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": { "type": "string", "minLength": 1 },
        "dirty": { "type": "boolean" }
      }
    },
    "case_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "valid_trials", "pass", "fail", "unknown", "result"],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "valid_trials": { "type": "integer", "minimum": 0 },
          "pass": { "type": "integer", "minimum": 0 },
          "fail": { "type": "integer", "minimum": 0 },
          "unknown": { "type": "integer", "minimum": 0 },
          "result": { "enum": ["pass", "fail", "mixed", "unknown"] }
        }
      }
    },
    "decision": { "enum": ["pass", "fail", "mixed", "unknown"] },
    "source_runs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": { "type": "string" }
  }
}
